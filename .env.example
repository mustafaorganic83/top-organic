# Copy this file to .env and fill in the values (php artisan key:generate sets APP_KEY)
APP_NAME="Top Organic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization (Iraq-first)
# Timestamps are stored in UTC; Asia/Baghdad is the Iraq display/business
# timezone (config/region.php). See architecture docs 03 & 04.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_IQ
APP_TIMEZONE=UTC

# Region pack (Iraq defaults) — see config/region.php
DEFAULT_REGION=IQ
DEFAULT_LOCALE=ar-IQ
DEFAULT_CURRENCY=IQD
SECONDARY_CURRENCY=USD
DISPLAY_TIMEZONE=Asia/Baghdad

# Database (MySQL 8, utf8mb4 for full Arabic Unicode)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=top_organic
DB_USERNAME=root
DB_PASSWORD=

# Cache / Queue / Session / Locks (Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# API auth — token-based for Flutter POS/KDS/mobile
# Production: use RS256. Supply key file/resource paths at deploy time; never
# embed PEM data, passphrases, or private keys in this file or a client build.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
JWT_ALGO=RS256
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_PASSPHRASE=
JWT_TTL=15
JWT_REFRESH_TTL=43200
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
IDENTITY_REQUIRE_AUTHORIZED_DEVICE=false
IDENTITY_ACCESS_AUDIENCE=top-organic-api
IDENTITY_OFFLINE_AUDIENCE=top-organic-offline-login
IDENTITY_PASSWORD_REQUIRE_LETTERS=true
IDENTITY_PASSWORD_REQUIRE_NUMBERS=true
IDENTITY_PASSWORD_REQUIRE_SYMBOLS=false
IDENTITY_MFA_CHALLENGE_TTL=5
IDENTITY_MFA_MAX_ATTEMPTS=5

# Realtime (Laravel Reverb WebSockets)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
